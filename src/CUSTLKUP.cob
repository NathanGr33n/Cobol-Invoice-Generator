>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CUSTLKUP.

*> Lookup customer by ID on indexed master file.
*> LS-STATUS: 0 = found, 1 = not found, 9 = file error

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CUSTOMER-FILE
        ASSIGN TO "data/CUSTOMERS.DAT"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CUST-ID
        FILE STATUS IS WS-CUST-STATUS.

DATA DIVISION.
FILE SECTION.
FD  CUSTOMER-FILE.
    COPY "CUSTREC.cpy".

WORKING-STORAGE SECTION.
01  WS-CUST-STATUS           PIC X(2).

LINKAGE SECTION.
01  LS-CUST-ID               PIC X(6).
01  LS-CUSTOMER-OUT.
    05  LS-OUT-ID            PIC X(6).
    05  LS-OUT-NAME          PIC X(30).
    05  LS-OUT-ADDR1         PIC X(30).
    05  LS-OUT-CITY          PIC X(20).
    05  LS-OUT-STATE         PIC X(2).
    05  LS-OUT-ZIP           PIC X(5).
    05  LS-OUT-TERMS         PIC 9(3).
    05  LS-OUT-TAX-RATE      PIC 9V9999.
01  LS-STATUS                PIC 9.

PROCEDURE DIVISION USING LS-CUST-ID
                          LS-CUSTOMER-OUT
                          LS-STATUS.
MAIN-LOGIC.
    MOVE 0 TO LS-STATUS
    INITIALIZE LS-CUSTOMER-OUT

    OPEN INPUT CUSTOMER-FILE
    IF WS-CUST-STATUS NOT = "00"
        DISPLAY "CUSTLKUP: OPEN failed status=" WS-CUST-STATUS
        MOVE 9 TO LS-STATUS
        GOBACK
    END-IF

    MOVE LS-CUST-ID TO CUST-ID
    READ CUSTOMER-FILE
        KEY IS CUST-ID
        INVALID KEY
            MOVE 1 TO LS-STATUS
            CLOSE CUSTOMER-FILE
            GOBACK
    END-READ

    IF WS-CUST-STATUS = "23"
        MOVE 1 TO LS-STATUS
        CLOSE CUSTOMER-FILE
        GOBACK
    END-IF

    IF WS-CUST-STATUS NOT = "00"
        DISPLAY "CUSTLKUP: READ failed status=" WS-CUST-STATUS
        MOVE 9 TO LS-STATUS
        CLOSE CUSTOMER-FILE
        GOBACK
    END-IF

    MOVE CUSTOMER-RECORD TO LS-CUSTOMER-OUT
    MOVE 0 TO LS-STATUS
    CLOSE CUSTOMER-FILE
    GOBACK.

END PROGRAM CUSTLKUP.
