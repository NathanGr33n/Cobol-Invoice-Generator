>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. INVGEN.

*> Batch invoice generator: control-break by customer,
*> validate lines, print invoices, rejects, and summary.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT LINE-ITEM-FILE
        ASSIGN TO "data/LINEITEMS.DAT"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-LI-STATUS.

    SELECT CONTROL-FILE
        ASSIGN TO "data/CONTROL.DAT"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-CTL-STATUS.

    SELECT INVOICE-FILE
        ASSIGN TO "output/INVOICES.TXT"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-INV-STATUS.

    SELECT REJECT-FILE
        ASSIGN TO "output/REJECTS.DAT"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-REJ-STATUS.

    SELECT SUMMARY-FILE
        ASSIGN TO "output/SUMMARY.TXT"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-SUM-STATUS.

DATA DIVISION.
FILE SECTION.
FD  LINE-ITEM-FILE.
01  LI-RAW                   PIC X(68).

FD  CONTROL-FILE.
01  CONTROL-RAW              PIC X(14).

FD  INVOICE-FILE.
01  INVOICE-LINE             PIC X(96).

FD  REJECT-FILE.
01  REJECT-RAW               PIC X(70).

FD  SUMMARY-FILE.
01  SUMMARY-LINE             PIC X(80).

WORKING-STORAGE SECTION.
01  WS-FILE-STATUS.
    05  WS-LI-STATUS         PIC X(2).
    05  WS-CTL-STATUS        PIC X(2).
    05  WS-INV-STATUS        PIC X(2).
    05  WS-REJ-STATUS        PIC X(2).
    05  WS-SUM-STATUS        PIC X(2).

01  WS-FLAGS.
    05  WS-LI-EOF            PIC X VALUE "N".
        88  LI-EOF           VALUE "Y".
    05  WS-FIRST-INVOICE     PIC X VALUE "Y".
        88  IS-FIRST-INV     VALUE "Y".
        88  NOT-FIRST-INV    VALUE "N".

COPY "LINEREC.cpy".
COPY "REJREC.cpy".
COPY "INVLINES.cpy".

01  WS-CONTROL.
    05  WS-NEXT-INV          PIC 9(6) VALUE 1.
    05  WS-INV-DATE          PIC 9(8) VALUE 20261003.

01  WS-CURRENT-CUST          PIC X(6) VALUE SPACES.
01  WS-PREV-CUST             PIC X(6) VALUE SPACES.
01  WS-GROUP-CUST            PIC X(6) VALUE SPACES.

01  WS-CUSTOMER.
    05  WS-CUST-ID           PIC X(6).
    05  WS-CUST-NAME         PIC X(30).
    05  WS-CUST-ADDR1        PIC X(30).
    05  WS-CUST-CITY         PIC X(20).
    05  WS-CUST-STATE        PIC X(2).
    05  WS-CUST-ZIP          PIC X(5).
    05  WS-CUST-TERMS        PIC 9(3).
    05  WS-CUST-TAX-RATE     PIC 9V9999.

01  WS-LOOKUP-STATUS         PIC 9 VALUE 0.
01  WS-VAL-STATUS            PIC 9 VALUE 0.
01  WS-VAL-REASON            PIC X(2) VALUE "00".
01  WS-DATE-STATUS           PIC 9 VALUE 0.
01  WS-DUE-DATE              PIC 9(8) VALUE 0.

01  WS-AMOUNTS.
    05  WS-LINE-AMT          PIC S9(7)V99 COMP-3 VALUE 0.
    05  WS-SUBTOTAL          PIC S9(7)V99 COMP-3 VALUE 0.
    05  WS-TAX-AMT           PIC S9(7)V99 COMP-3 VALUE 0.
    05  WS-TOTAL             PIC S9(7)V99 COMP-3 VALUE 0.
    05  WS-TAX-PCT           PIC 9(3)V99 VALUE 0.

01  WS-RUN-TOTALS.
    05  WS-INV-COUNT         PIC 9(5) VALUE 0.
    05  WS-LINE-COUNT        PIC 9(7) VALUE 0.
    05  WS-REJ-COUNT         PIC 9(7) VALUE 0.
    05  WS-GRAND-BILLED      PIC S9(9)V99 COMP-3 VALUE 0.
    05  WS-GRAND-TAX         PIC S9(9)V99 COMP-3 VALUE 0.
    05  WS-VALID-IN-GROUP    PIC 9(5) VALUE 0.

01  WS-EDIT-FIELDS.
    05  WS-DATE-YYYY         PIC 9(4).
    05  WS-DATE-MM           PIC 9(2).
    05  WS-DATE-DD           PIC 9(2).
    05  WS-FMT-DATE          PIC X(10).
    05  WS-CSZ               PIC X(40).
    05  WS-JOB-DATE-N        PIC 9(8).

01  WS-SUMMARY-TEXT.
    05  WS-SUM-TITLE         PIC X(80) VALUE
        "INVOICE RUN SUMMARY - HARDLINE STRIPING LLC".
    05  WS-SUM-INV.
        10  FILLER           PIC X(20) VALUE "Invoices generated: ".
        10  WS-SUM-INV-N     PIC ZZ,ZZ9.
        10  FILLER           PIC X(53) VALUE SPACES.
    05  WS-SUM-LINES.
        10  FILLER           PIC X(20) VALUE "Line items read:    ".
        10  WS-SUM-LI-N      PIC ZZ,ZZ9.
        10  FILLER           PIC X(53) VALUE SPACES.
    05  WS-SUM-REJ.
        10  FILLER           PIC X(20) VALUE "Rejects:            ".
        10  WS-SUM-REJ-N     PIC ZZ,ZZ9.
        10  FILLER           PIC X(53) VALUE SPACES.
    05  WS-SUM-BILLED.
        10  FILLER           PIC X(20) VALUE "Grand total billed: ".
        10  WS-SUM-BILL-N    PIC $$$,$$$,$$9.99.
        10  FILLER           PIC X(44) VALUE SPACES.
    05  WS-SUM-TAX.
        10  FILLER           PIC X(20) VALUE "Total tax:          ".
        10  WS-SUM-TAX-N     PIC $$$,$$$,$$9.99.
        10  FILLER           PIC X(44) VALUE SPACES.

01  WS-WORK-LINE             PIC X(68).

PROCEDURE DIVISION.
MAIN.
    PERFORM OPEN-FILES
    PERFORM READ-CONTROL
    PERFORM READ-LINE-ITEM
    PERFORM UNTIL LI-EOF
        MOVE LI-CUST-ID TO WS-GROUP-CUST
        PERFORM PROCESS-CUSTOMER-GROUP
    END-PERFORM
    PERFORM WRITE-SUMMARY
    PERFORM WRITE-CONTROL
    PERFORM CLOSE-FILES
    DISPLAY "INVGEN complete. Invoices=" WS-INV-COUNT
        " Rejects=" WS-REJ-COUNT
    MOVE 0 TO RETURN-CODE
    STOP RUN.

OPEN-FILES.
    OPEN INPUT LINE-ITEM-FILE
    IF WS-LI-STATUS NOT = "00"
        DISPLAY "OPEN LINEITEMS failed status=" WS-LI-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF

    OPEN INPUT CONTROL-FILE
    IF WS-CTL-STATUS NOT = "00"
        DISPLAY "OPEN CONTROL failed status=" WS-CTL-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF

    OPEN OUTPUT INVOICE-FILE
    IF WS-INV-STATUS NOT = "00"
        DISPLAY "OPEN INVOICES failed status=" WS-INV-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF

    OPEN OUTPUT REJECT-FILE
    IF WS-REJ-STATUS NOT = "00"
        DISPLAY "OPEN REJECTS failed status=" WS-REJ-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF

    OPEN OUTPUT SUMMARY-FILE
    IF WS-SUM-STATUS NOT = "00"
        DISPLAY "OPEN SUMMARY failed status=" WS-SUM-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    .

CLOSE-FILES.
    CLOSE LINE-ITEM-FILE
    *> CONTROL-FILE is closed after read and again after rewrite
    CLOSE INVOICE-FILE
    CLOSE REJECT-FILE
    CLOSE SUMMARY-FILE
    .

READ-CONTROL.
    READ CONTROL-FILE
        AT END
            DISPLAY "CONTROL.DAT empty"
            MOVE 1 TO RETURN-CODE
            STOP RUN
    END-READ
    IF WS-CTL-STATUS NOT = "00"
        DISPLAY "READ CONTROL failed status=" WS-CTL-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    MOVE CONTROL-RAW(1:6) TO WS-NEXT-INV
    MOVE CONTROL-RAW(7:8) TO WS-INV-DATE
    IF WS-NEXT-INV IS NOT NUMERIC OR WS-INV-DATE IS NOT NUMERIC
        DISPLAY "CONTROL.DAT contents invalid"
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    CLOSE CONTROL-FILE
    .

WRITE-CONTROL.
    OPEN OUTPUT CONTROL-FILE
    IF WS-CTL-STATUS NOT = "00"
        DISPLAY "REWRITE CONTROL open failed status=" WS-CTL-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    MOVE SPACES TO CONTROL-RAW
    STRING WS-NEXT-INV DELIMITED BY SIZE
           WS-INV-DATE DELIMITED BY SIZE
           INTO CONTROL-RAW
    WRITE CONTROL-RAW
    IF WS-CTL-STATUS NOT = "00"
        DISPLAY "WRITE CONTROL failed status=" WS-CTL-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    CLOSE CONTROL-FILE
    .

READ-LINE-ITEM.
    IF LI-EOF
        EXIT PARAGRAPH
    END-IF
    READ LINE-ITEM-FILE
        AT END
            SET LI-EOF TO TRUE
            EXIT PARAGRAPH
    END-READ
    IF WS-LI-STATUS NOT = "00" AND WS-LI-STATUS NOT = "10"
        DISPLAY "READ LINEITEMS failed status=" WS-LI-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    IF LI-EOF
        EXIT PARAGRAPH
    END-IF

    ADD 1 TO WS-LINE-COUNT
    MOVE LI-RAW TO WS-WORK-LINE
    MOVE WS-WORK-LINE TO LINE-ITEM-RECORD

    *> Out-of-sequence check vs previous record
    IF WS-PREV-CUST NOT = SPACES
        IF LI-CUST-ID < WS-PREV-CUST
            PERFORM REJECT-OUT-OF-SEQUENCE
            PERFORM READ-LINE-ITEM
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE LI-CUST-ID TO WS-PREV-CUST
    .

REJECT-OUT-OF-SEQUENCE.
    MOVE "05" TO REJ-REASON
    MOVE LINE-ITEM-RECORD TO REJ-LINE-ITEM
    PERFORM WRITE-REJECT
    .

PROCESS-CUSTOMER-GROUP.
    MOVE WS-GROUP-CUST TO WS-CURRENT-CUST
    MOVE 0 TO WS-SUBTOTAL
    MOVE 0 TO WS-TAX-AMT
    MOVE 0 TO WS-TOTAL
    MOVE 0 TO WS-VALID-IN-GROUP

    CALL "CUSTLKUP" USING WS-CURRENT-CUST
                          WS-CUSTOMER
                          WS-LOOKUP-STATUS

    IF WS-LOOKUP-STATUS = 9
        DISPLAY "Customer file error"
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF

    IF WS-LOOKUP-STATUS = 1
        PERFORM REJECT-UNKNOWN-GROUP
        EXIT PARAGRAPH
    END-IF

    *> Customer found — process lines until break
    PERFORM UNTIL LI-EOF OR LI-CUST-ID NOT = WS-GROUP-CUST
        PERFORM PROCESS-ONE-LINE
        PERFORM READ-LINE-ITEM
    END-PERFORM

    IF WS-VALID-IN-GROUP > 0
        PERFORM FINISH-INVOICE
    END-IF
    .

REJECT-UNKNOWN-GROUP.
    PERFORM UNTIL LI-EOF OR LI-CUST-ID NOT = WS-GROUP-CUST
        MOVE "01" TO REJ-REASON
        MOVE LINE-ITEM-RECORD TO REJ-LINE-ITEM
        PERFORM WRITE-REJECT
        PERFORM READ-LINE-ITEM
    END-PERFORM
    .

PROCESS-ONE-LINE.
    CALL "VALIDATE" USING LINE-ITEM-RECORD
                          WS-VAL-REASON
                          WS-VAL-STATUS
    IF WS-VAL-STATUS NOT = 0
        MOVE WS-VAL-REASON TO REJ-REASON
        MOVE LINE-ITEM-RECORD TO REJ-LINE-ITEM
        PERFORM WRITE-REJECT
        EXIT PARAGRAPH
    END-IF

    COMPUTE WS-LINE-AMT ROUNDED = LI-QTY * LI-UNIT-PRICE
    ADD WS-LINE-AMT TO WS-SUBTOTAL
    ADD 1 TO WS-VALID-IN-GROUP

    IF WS-VALID-IN-GROUP = 1
        PERFORM WRITE-INVOICE-HEADER
    END-IF
    PERFORM WRITE-DETAIL-LINE
    .

FINISH-INVOICE.
    COMPUTE WS-TAX-AMT ROUNDED =
        WS-SUBTOTAL * WS-CUST-TAX-RATE
    COMPUTE WS-TOTAL = WS-SUBTOTAL + WS-TAX-AMT
    COMPUTE WS-TAX-PCT = WS-CUST-TAX-RATE * 100
    PERFORM WRITE-INVOICE-FOOTER
    ADD 1 TO WS-INV-COUNT
    ADD 1 TO WS-NEXT-INV
    ADD WS-TOTAL TO WS-GRAND-BILLED
    ADD WS-TAX-AMT TO WS-GRAND-TAX
    SET NOT-FIRST-INV TO TRUE
    .

WRITE-REJECT.
    MOVE SPACES TO REJECT-RAW
    MOVE REJECT-RECORD TO REJECT-RAW
    WRITE REJECT-RAW
    IF WS-REJ-STATUS NOT = "00"
        DISPLAY "WRITE REJECT failed status=" WS-REJ-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    ADD 1 TO WS-REJ-COUNT
    .

WRITE-INV-LINE.
    WRITE INVOICE-LINE
    IF WS-INV-STATUS NOT = "00"
        DISPLAY "WRITE INVOICE failed status=" WS-INV-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    .

WRITE-INVOICE-HEADER.
    IF NOT-FIRST-INV
        MOVE INV-FORM-FEED TO INVOICE-LINE
        PERFORM WRITE-INV-LINE
    END-IF

    MOVE WS-NEXT-INV TO INV-NUMBER-OUT

    MOVE WS-INV-DATE TO WS-JOB-DATE-N
    PERFORM FORMAT-DATE
    MOVE WS-FMT-DATE TO INV-DATE-OUT

    CALL "DATEUTIL" USING WS-INV-DATE
                          WS-CUST-TERMS
                          WS-DUE-DATE
                          WS-DATE-STATUS
    IF WS-DATE-STATUS NOT = 0
        MOVE WS-INV-DATE TO WS-DUE-DATE
    END-IF
    MOVE WS-DUE-DATE TO WS-JOB-DATE-N
    PERFORM FORMAT-DATE
    MOVE WS-FMT-DATE TO INV-DUE-OUT

    MOVE WS-CUST-NAME TO INV-CUST-NAME-OUT
    MOVE WS-CUST-ADDR1 TO INV-CUST-ADDR-OUT
    MOVE SPACES TO WS-CSZ
    STRING FUNCTION TRIM(WS-CUST-CITY) DELIMITED BY SIZE
           ", " DELIMITED BY SIZE
           WS-CUST-STATE DELIMITED BY SIZE
           " " DELIMITED BY SIZE
           WS-CUST-ZIP DELIMITED BY SIZE
           INTO WS-CSZ
    MOVE WS-CSZ TO INV-CSZ-OUT

    MOVE INV-COMPANY-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-NUMBER-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-DATE-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-BLANK-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-BILLTO-LABEL TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-BILLTO-NAME TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-BILLTO-ADDR TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-BILLTO-CSZ TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-BLANK-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-COL-HEADER TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE INV-COL-RULE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    .

WRITE-DETAIL-LINE.
    MOVE LI-JOB-DATE TO WS-JOB-DATE-N
    PERFORM FORMAT-DATE
    MOVE WS-FMT-DATE TO INV-DET-DATE
    MOVE LI-DESC TO INV-DET-DESC
    MOVE LI-QTY TO INV-DET-QTY
    MOVE LI-UNIT-PRICE TO INV-DET-PRICE
    MOVE WS-LINE-AMT TO INV-DET-AMT
    MOVE INV-DETAIL-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    .

WRITE-INVOICE-FOOTER.
    MOVE INV-BLANK-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE WS-SUBTOTAL TO INV-SUB-OUT
    MOVE INV-SUBTOTAL-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE WS-TAX-PCT TO INV-TAX-PCT-OUT
    MOVE WS-TAX-AMT TO INV-TAX-OUT
    MOVE INV-TAX-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    MOVE WS-TOTAL TO INV-TOT-OUT
    MOVE INV-TOTAL-LINE TO INVOICE-LINE
    PERFORM WRITE-INV-LINE
    .

FORMAT-DATE.
    *> WS-JOB-DATE-N YYYYMMDD -> WS-FMT-DATE YYYY-MM-DD
    MOVE WS-JOB-DATE-N(1:4) TO WS-DATE-YYYY
    MOVE WS-JOB-DATE-N(5:2) TO WS-DATE-MM
    MOVE WS-JOB-DATE-N(7:2) TO WS-DATE-DD
    MOVE SPACES TO WS-FMT-DATE
    STRING WS-DATE-YYYY DELIMITED BY SIZE
           "-" DELIMITED BY SIZE
           WS-DATE-MM DELIMITED BY SIZE
           "-" DELIMITED BY SIZE
           WS-DATE-DD DELIMITED BY SIZE
           INTO WS-FMT-DATE
    .

WRITE-SUMMARY.
    MOVE WS-SUM-TITLE TO SUMMARY-LINE
    WRITE SUMMARY-LINE
    MOVE INV-BLANK-LINE TO SUMMARY-LINE
    WRITE SUMMARY-LINE
    MOVE WS-INV-COUNT TO WS-SUM-INV-N
    MOVE WS-SUM-INV TO SUMMARY-LINE
    WRITE SUMMARY-LINE
    MOVE WS-LINE-COUNT TO WS-SUM-LI-N
    MOVE WS-SUM-LINES TO SUMMARY-LINE
    WRITE SUMMARY-LINE
    MOVE WS-REJ-COUNT TO WS-SUM-REJ-N
    MOVE WS-SUM-REJ TO SUMMARY-LINE
    WRITE SUMMARY-LINE
    MOVE WS-GRAND-BILLED TO WS-SUM-BILL-N
    MOVE WS-SUM-BILLED TO SUMMARY-LINE
    WRITE SUMMARY-LINE
    MOVE WS-GRAND-TAX TO WS-SUM-TAX-N
    MOVE WS-SUM-TAX TO SUMMARY-LINE
    WRITE SUMMARY-LINE
    IF WS-SUM-STATUS NOT = "00"
        DISPLAY "WRITE SUMMARY failed status=" WS-SUM-STATUS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    .

END PROGRAM INVGEN.
